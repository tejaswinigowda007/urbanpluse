# ===============================================
# UrbanPulse — Environment Configuration Template
# ===============================================

# Server Port & Host
PORT=8000
HOST=127.0.0.1

# Security & Authentication
JWT_SECRET=urbanpulse_secret_jwt_key_2026_super_secure_production_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Set USE_MONGODB=true to connect to MongoDB. If MongoDB is unavailable, UrbanPulse automatically uses SQLite local fallback.
USE_MONGODB=true
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=urbanpulse

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173